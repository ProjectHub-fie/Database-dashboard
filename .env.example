# ------------------------------------------------------------------
# DB Horizon server configuration
# All values below are PLACEHOLDERS — never store real secrets here.
# Copy to packages/server/.env or export in the process environment.
# ------------------------------------------------------------------

# Server
# Set to true when behind a TLS-terminating reverse proxy (requires trustProxy)
PORT=3001
HOST=127.0.0.1
NODE_ENV=production

# Comma-separated list of browser origins allowed for the API.
CORS_ORIGINS=http://localhost:5173

# Session cookie settings (production should inherit secure from HTTPS)
# Base secret used only when COOKIE_SECRET is not set (development). Override in prod.
COOKIE_SECRET=change-me-in-production
SESSION_TTL_MS=28800000
IDLE_SESSION_TTL_MS=1800000
SESSION_REAUTH_TTL_MS=600000

# Files for uploaded CSV/JSON/SQL files
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400