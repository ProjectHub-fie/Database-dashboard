# ------------------------------------------------------------------
# DB Horizon server configuration
# All values below are PLACEHOLDERS — never store real secrets here.
# Copy to packages/server/.env or export in the process environment.
# ------------------------------------------------------------------

# Server
# Set to true when behind a TLS-terminating reverse proxy (requires trustProxy)
PORT=3001
HOST=127.0.0.1
NODE_ENV=production

# Comma-separated list of browser origins allowed for the API.
CORS_ORIGINS=http://localhost:5173

# Session cookie settings (production should inherit secure from HTTPS)
# Base secret used only when COOKIE_SECRET is not set (development). Override in prod.
COOKIE_SECRET=change-me-in-production

# Initial dashboard operator. Created once on first start, only when
# ADMIN_INITIAL_PASSWORD is present and at least 12 characters. There is no
# default password. Remove this variable after the first boot; rotating the
# password afterwards is done through the dashboard.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Account enforcement. Set to true to require a dashboard sign-in before any
# database or provider connection can be opened. Default false while the
# connection flows are exercised; the account system is fully implemented and
# flipping this restores the complete login gate with no code changes.
AUTH_REQUIRED=false
SESSION_TTL_MS=28800000
IDLE_SESSION_TTL_MS=1800000
SESSION_REAUTH_TTL_MS=600000

# Files for uploaded CSV/JSON/SQL files
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400
# Reverse-proxy trust. Keep TRUST_PROXY=false unless a reverse proxy terminates
# TLS in front of this server. When enabled, TRUST_PROXY_HOPS must match the
# number of proxies in front of the app (1 for a single Vercel/nginx hop) so
# client-forged X-Forwarded-For headers cannot bypass IP rate limiting.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# Serve the built SPA from this server (defaults to true only in production).
# Enable it for staging or local production-mode smoke tests.
SERVE_CLIENT=false

# Directory for the dashboard's own SQLite store (users, sessions, audit log).
DATA_DIR=./data
